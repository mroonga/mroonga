require_relative "../mroonga-package-task"

class MariaDB123MroongaPackageTask < MroongaPackageTask
  def initialize
    super("mariadb-12.3-mroonga")
  end

  def eanble_apt?
    false
  end

  def enable_ubuntu?
    false
  end

  def yum_targets_default
    [
      "almalinux-8",
      "almalinux-9",
      "almalinux-10",
    ]
  end
end

task = MariaDB123MroongaPackageTask.new
task.define

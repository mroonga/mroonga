require_relative "../mroonga-package-task"

class MySQLCommunity97MroongaPackageTask < MroongaPackageTask
  def initialize
    super("mysql-community-9.7-mroonga")
  end

  def apt_targets_default
    [
      "ubuntu-jammy",
      "ubuntu-noble",
    ]
  end

  def enable_ubuntu?
    false
  end

  def yum_targets_default
    [
      "almalinux-8",
      "almalinux-9",
      "almalinux-10",
    ]
  end
end

task = MySQLCommunity97MroongaPackageTask.new
task.define

CREATE TABLE diaries (
id INT PRIMARY KEY AUTO_INCREMENT,
body TEXT,
FULLTEXT INDEX (body)
) COMMENT = 'ENGINE "InnoDB"' DEFAULT CHARSET UTF8MB4;

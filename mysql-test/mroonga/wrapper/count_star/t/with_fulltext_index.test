--source ../../../include/mroonga/have_mariadb_11_0_or_later.inc
--source ../../../include/mroonga/have_innodb.inc
--source ../../../include/mroonga/have_mroonga.inc

--disable_query_log
DROP DATABASE test;
CREATE DATABASE test;
USE test;
--enable_query_log

CREATE TABLE diaries (
  id INT PRIMARY KEY AUTO_INCREMENT,
  body TEXT,
  FULLTEXT INDEX (body)
) COMMENT = 'ENGINE "InnoDB"' DEFAULT CHARSET UTF8MB4;

INSERT INTO diaries (body) VALUES ("will start groonga!");
INSERT INTO diaries (body) VALUES ("starting groonga...");
INSERT INTO diaries (body) VALUES ("started groonga.");

-- replace_column 9 #
EXPLAIN SELECT COUNT(*) FROM diaries;
SELECT COUNT(*) FROM diaries;

DROP TABLE diaries;

--source ../../../include/mroonga/have_mroonga_deinit.inc
